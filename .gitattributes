# Normalize line endings so files regenerated by the Flutter tool (which
# writes LF) don't show as modified on Windows checkouts (core.autocrlf).
* text=auto

# Windows scripts checkout with CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.bin binary
*.dll binary
*.exe binary
*.zip binary
