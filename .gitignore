# Personal Claude Code settings stay local.
.claude/settings.local.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Editor settings are per-developer, not project configuration.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/dist/
/coverage/
node_modules/
.gitnexus/

# The bundled speech runtimes (models + binaries) are fetched with
# tool/fetch_whisper_runtime.dart. The models are too large for git (GitHub
# rejects files over 100 MB) and the binaries follow them for consistency.
/models/*.bin
/models/*.onnx
/models/*.part
/models/parakeet-tdt-0.6b-v3-int8/
/bin/whisper/*.exe
/bin/whisper/*.dll
/bin/sherpa/*.exe

# Play Store artwork staged locally for the listing upload; the listing
# copy itself lives in docs/android/play-store-listing.md.
/docs/android/store-assets/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# sherpa-onnx websocket server log when run manually from the repo root
log.txt

# Flutter-generated plugin registrants — regenerated by `flutter pub get`
# on every build (CI included), so tracking them only causes churn.
**/flutter/generated_plugin_registrant.cc
**/flutter/generated_plugin_registrant.h
**/flutter/generated_plugins.cmake
**/Flutter/GeneratedPluginRegistrant.swift

# Sentry native runtime artifacts
.sentry-native/
