# Personal Claude Code settings stay local.
.claude/settings.local.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/dist/
/coverage/
node_modules/
.gitnexus/

# The bundled speech runtimes (models + binaries) are fetched with
# tool/fetch_whisper_runtime.dart. The models are too large for git (GitHub
# rejects files over 100 MB) and the binaries follow them for consistency.
/models/*.bin
/models/*.onnx
/models/*.part
# Every Parakeet model directory: English (parakeet-unified-en-0.6b-int8)
# and the multilingual TDT v3, plus any candidate fetched for benchmarking.
/models/parakeet-*/
/bin/whisper/*.exe
/bin/whisper/*.dll
/bin/sherpa/*.exe

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Play upload signing secrets — never commit the keystore or its passwords.
/android/key.properties
*.jks
*.keystore

# sherpa-onnx websocket server log when run manually from the repo root
log.txt

# Flutter-generated plugin registrants — regenerated by `flutter pub get`
# on every build (CI included), so tracking them only causes churn.
**/flutter/generated_plugin_registrant.cc
**/flutter/generated_plugin_registrant.h
**/flutter/generated_plugins.cmake
**/Flutter/GeneratedPluginRegistrant.swift

# Sentry native runtime artifacts
.sentry-native/

# STT benchmark audio inside language/cluster subfolders: personal
# recordings plus dataset clips we may not redistribute. The 18 synthetic
# edge-tts clips ARE committed, but only because they were added with
# `git add -f` — this rule would otherwise swallow them, so a new
# synthetic clip needs the same -f or it silently never lands in the
# repo. manifest.json sits at the corpus root and is never ignored.
/test_assets/stt_benchmark/*/**
