<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: the adaptive launcher icon on white, so
     the hand-off into the app's own (white) splash screen is seamless.
     The app is light-themed throughout, so dark mode uses the same
     background (values-night-v31 mirrors this on purpose). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
