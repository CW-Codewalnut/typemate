#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

FLUTTER="R:/Tools/flutter/bin/flutter"
DART="R:/Tools/flutter/bin/dart"

if [ ! -x "$FLUTTER" ]; then
  FLUTTER="flutter"
  DART="dart"
fi

$DART format --set-exit-if-changed lib test integration_test tool
$FLUTTER analyze
